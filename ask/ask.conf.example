# Конфиг ask-hook.sh: вопросы AskUserQuestion в HTML-оверлее agterm.
# Формат «ключ = значение», конфиг читается как данные и не исполняется.

# no: хук ничего не делает, вопросы задаются в терминале как обычно.
enabled = yes

# yes: переключить agterm на сессию агента, когда он задаёт вопрос.
# no: оверлей ждёт в сессии агента, пока вы на неё не перейдёте.
follow = no

# Ширина плавающей панели в процентах от сессии. 0 или 100: оверлей на всю сессию.
size = 80
