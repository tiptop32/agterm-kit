# Конфиг wt. Путь по умолчанию: ~/.config/agterm-kit/wt.conf
# (другой путь задаёт переменная WT_CONFIG).
#
# Формат: «ключ = значение», одна пара на строку. Строки с # в начале
# и хвост после « #» считаются комментариями. В начале пути понимаются ~ и $HOME.
#
# Worktree ложится рядом с репой: <родитель репы>/worktrees/<репа>/<постфикс>.
# Например, ~/git/api → ~/git/worktrees/api/fix-login. Отдельно это не настраивается.

# Где лежат клоны реп. Ключ можно повторять. Значение — каталог с клонами
# или сам клон. Если wt вызван вне git-репы, репа ищется здесь по имени
# воркспейса agterm, по порядку: при одинаковых именах выигрывает первый.
repos = ~/git
# repos = ~/work/git
# repos = ~/warp
